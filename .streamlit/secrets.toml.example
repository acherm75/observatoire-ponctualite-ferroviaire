# Copier en .streamlit/secrets.toml (ignoré par git) pour lancer l'assistant en local.
# Sur Streamlit Cloud : Settings -> Secrets, coller le même contenu.

# Fournisseur gratuit : "gemini" (aistudio.google.com), "groq" (console.groq.com) ou "mistral" (console.mistral.ai)
ASSISTANT_FOURNISSEUR = "gemini"
ASSISTANT_CLE_API = "colle-ta-cle-ici"

# Optionnel : relais chez un second fournisseur gratuit quand le premier n'a plus de quota
# ASSISTANT_SECOURS_FOURNISSEUR = "groq"
# ASSISTANT_SECOURS_CLE_API = "colle-ta-cle-groq-ici"

# Optionnel
# ASSISTANT_MODELE = "gemini-3.5-flash-lite,gemini-3.5-flash"   # par ordre de préférence (relais si quota épuisé)
ASSISTANT_QUESTIONS_PAR_SESSION = 10       # protège le quota gratuit
ASSISTANT_QUESTIONS_PAR_JOUR = 100
