table dim_cause

	column code_cause
		dataType: string
		summarizeBy: none
		sourceColumn: code_cause

	column libelle_cause
		dataType: string
		summarizeBy: none
		sourceColumn: libelle_cause
		sortByColumn: ordre

	column responsable
		dataType: string
		summarizeBy: none
		sourceColumn: responsable

	column ordre
		dataType: int64
		summarizeBy: none
		sourceColumn: ordre

	partition dim_cause = m
		mode: import
		source =
				let
				    Source = Parquet.Document ( Binary.Buffer ( Web.Contents ( UrlDonnees, [ RelativePath = "dim_cause.parquet" ] ) ) )
				in
				    Source

	annotation PBI_ResultType = Table
